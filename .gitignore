# «Ваш Подъёмник» — .gitignore

# Локальные данные и загрузки (создаются автоматически на сервере)
/data/*.sqlite*
/data/*.sqlite3*
/data/*.db*
/uploads/*
!/uploads/.gitkeep
!/uploads/.htaccess
!/data/.gitkeep
!/data/.htaccess

# Локальные инструменты и кэши
/.claude
/.openai
/node_modules
/dist
/.wrangler
/.sites-runtime
/.vinext
/.next
/out
.DS_Store
Thumbs.db
*.pem
npm-debug.log*

# Freebuff desktop app data (local chat DB)
/.freebuff
