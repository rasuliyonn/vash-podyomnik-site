# Загрузки: разрешаем только статику. Исполняемые файлы в uploads/ запрещены,
# даже если фильтр типов в админке будет изменён.
<FilesMatch "\.(php|phtml|phar|pl|py|cgi|sh|htaccess|ini)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
Options -Indexes
